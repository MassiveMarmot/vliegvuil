# VliegVuil.nl - Caddy v2 configuration
#
# Requires a custom binary (rate limiting + micro-cache are Caddy modules,
# not built into the standard distribution). See docs/deploy.md:
#
#   xcaddy build \
#     --with github.com/mholt/caddy-ratelimit \
#     --with github.com/caddyserver/cache-handler \
#     --with github.com/darkweak/storages/otter/caddy
#
# Modules verified:
#   - https://github.com/mholt/caddy-ratelimit (rate_limit directive)
#   - https://github.com/caddyserver/cache-handler (cache directive; since
#     Souin v1.7.0 a storage module must be built in, hence darkweak/storages/otter)

# Privacy: Caddy does not write access logs unless an access log is explicitly
# configured, so no `access_log off` directive is needed or valid here.
# Error logs go to stderr/journal only — but by default Caddy's HTTP error
# logger (http.log.error) embeds the FULL request object (remote_ip,
# client_ip, headers, URI) in every failed/cancelled request. With the SPA
# polling /api every 5 s, browser navigation cancels polls routinely, so
# visitor IPs would accumulate in the systemd journal (session 25c finding,
# 2026-10-30). Fix (verified against the Caddy 2.11.7 source,
# modules/logging/filterencoder.go + modules/caddyhttp/server.go):
#  - route http.log.error entries to a dedicated 'scrubbed' log whose
#    filter encoder DELETES the request object entirely (the IPs, headers
#    and the URI — which also leaks the map viewport position — all live
#    in it) and redacts any IP that a Go network error message may embed
#    in the top-level error field;
#  - exclude the same logger from the default log so the entries are not
#    ALSO written unscrubbed there (entries go to every matching log).
# Note (filterencoder.go): ts, level, logger and msg cannot be filtered;
# msg never contains IPs for these entries ("context canceled" etc.), so
# that is safe.
{
	log scrubbed {
		include http.log.error
		output stderr
		format filter {
			wrap json
			request delete
			error regexp "\b\d{1,3}(\.\d{1,3}){3}(:\d+)?\b" "[ip]"
		}
	}
	log {
		exclude http.log.error
	}
}

vliegvuil.nl {
	# Static app (git pull + pnpm build on the server, see docs/deploy.md)
	root * /srv/vliegvuil/web/dist
	encode zstd gzip

	# Security headers (same origin only; the API is proxied below, so no
	# third-party origins appear in connect-src and no CORS headers exist).
	header {
		# style-src has no 'unsafe-inline': maplibre-gl 6.14.0 (resolved
		# version in pnpm-lock.yaml; the vendor chunk ships inside
		# assets/Map-*.js) and the built bundle contain no
		# createElement('style'), no setAttribute('style') and no
		# style.cssText (re-verified 2026-10-30 by grepping the built
		# web/dist for createElement/setAttribute with a style argument
		# and for cssText: zero matches in every chunk, our code and
		# maplibre both; React style props and maplibre's marker sizing go
		# through the CSSOM (el.style.<prop> assignments), which CSP does
		# not restrict). Re-run that grep whenever maplibre-gl is upgraded
		# (docs/deploy.md, Privacy properties).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-X-XSS-Protection
		# HSTS (PR decision, docs/BUILD.md §6 "Before 25b"): one-day first
		# step of the ramp-up. No includeSubDomains (stats. must serve valid
		# HTTPS before that is ever considered), no preload. This site-level
		# header applies to every response of the block, /api included; the
		# /api handler's header_down -Strict-Transport-Security strips the
		# upstream's header only (it runs in the reverse_proxy transport, not
		# here).
		Strict-Transport-Security "max-age=86400"
	}

	# Root redirect: / has no language segment, so the app would show its
	# not-found page. Send visitors to the right language immediately:
	# 302 (not 301, so browser/language changes are not sticky), no-store
	# so proxies never cache a personal redirect, and Vary so caches key
	# on the request language. en only when the FIRST Accept-Language tag
	# is English (q-values are not parsed; a leading en-US, en-GB etc.
	# counts, anything else - including de, nl, no header - falls back
	# to the default language nl).
	@root path /
	handle @root {
		header Vary Accept-Language
		header Cache-Control "no-store"
		@en header_regexp Accept-Language "^\s*en([-;,\s]|$)"
		redir @en /en/ 302
		# The * matcher is required: without it, Caddy parses "redir /nl/ 302"
		# as path matcher /nl/ with target 302, which never matches and
		# leaves / answering an empty 200 for non-English requests.
		redir * /nl/ 302
	}

	# Same-origin API proxy: /api/* -> https://opendata.adsb.fi/api/v2/*
	# This removes CORS entirely: the browser only ever talks to vliegvuil.nl.
	#
	# The app (core/src/providers/adsb-fi.ts buildUrl) only ever requests
	# GET /api/lat/{lat 4 decimals}/lon/{lon 4 decimals}/dist/{int} with a
	# numeric lat/lon and an integer radius. Only that shape is proxied:
	# any other /api path answers 404 (an unmatched handle_path falls
	# through to the static site), and any other method answers 405 via
	# the explicit method matcher. POST/PUT/DELETE never reach adsb.fi.
	# Hardening (review finding): the cache key includes the query string,
	# so ?x=1, ?x=2, ... would bypass the 5 s micro-cache and reach
	# adsb.fi individually (their public limit is 1 req/s — an attacker
	# could get the server blocked). The app NEVER sends a query, so any
	# query on this shape is not from our app: reject it with the same
	# 404 the catch-all below gives unknown /api paths (404 over 400: it
	# stays indistinguishable from a nonexistent resource, teaching a
	# prober nothing about the shape). Only the query-FREE path is ever
	# proxied or cached.
	@api_shaped {
		path_regexp ^/api/lat/-?[0-9]+(\.[0-9]+)?/lon/-?[0-9]+(\.[0-9]+)?/dist/[0-9]+/?$
		method GET HEAD
		# Bare `query` matches ONLY an empty query string (verified in the
		# Caddy 2.11.7 source, matchers.go MatchQuery.MatchWithError: an
		# empty matcher matches len(r.URL.Query()) == 0), so any request
		# with ANY query parameter fails this matcher and falls through to
		# the /api/* catch-all below (404).
		query
	}
	# handle blocks are mutually exclusive and evaluated in order, so the
	# specific @api_shaped block must come first; the /api/* catch-all
	# then answers everything the app would never request.
	handle @api_shaped {
		# Rate limit (review finding: 60/min admitted only ~5 app instances
		# behind one shared IPv4 (CGNAT, school, office) and an IPv6 client
		# could rotate /128s freely). Key: remote.host/32,64 — all 32 bits
		# for IPv4 (unchanged identity), the top 64 bits for IPv6 (the
		# standard customer prefix: rotating inside it now hits the SAME
		# bucket). Budget: the app polls 12/min; 240/min leaves headroom
		# for ~15+ app instances per household/office and manual reloads,
		# while still capping one key far below anything that threatens
		# adsb.fi (the micro-cache means distinct upstream requests are
		# much rarer than requests here).
		rate_limit {
			zone api_per_ip {
				key {http.request.remote.host/32,64}
				events 240
				window 1m
			}
		}

		# ~5s micro-cache to reduce load on adsb.fi (their public limit
		# is 1 req/s; our poll rate is 1 req/5s). The upstream sends
		# `Cache-Control: no-store`, which in Souin's default strict mode
		# would make every response NO-STORE-DIRECTIVE and never cached.
		# `bypass_response` ignores the upstream response's cache
		# directives only; request-side RFC 7234 rules still apply.
		cache {
			ttl 5s
			mode bypass_response
			otter {
				configuration {
					size 10000
				}
			}
		}

		# route preserves the order below: strip /api first, then add the
		# upstream /api/v2 prefix, then proxy. Without route, Caddy sorts
		# rewrite before uri, which would produce the wrong prefix order.
		# {path} (query-free, /api already stripped) builds the upstream
		# URL: the client's query string can never reach adsb.fi nor vary
		# the cache key, even if a future matcher change lets one through.
		route {
			uri strip_prefix /api
			rewrite * /api/v2{path}

			reverse_proxy https://opendata.adsb.fi {
				# The upstream nginx routes by virtual host; without this,
				# the client's Host header is passed through and the default
				# backend answers 503.
				header_up Host opendata.adsb.fi

				# Privacy: strip anything that could identify the client.
				# reverse_proxy adds X-Forwarded-For itself; deleting it here
				# means the upstream never sees the client IP.
				header_up -X-Forwarded-For
				header_up -X-Real-IP
				header_up -X-Forwarded-Proto
				header_up -X-Forwarded-Host
				# Present ourselves instead of the client
				header_up User-Agent "VliegVuil.nl/1.0 (+https://vliegvuil.nl)"
				header_up Accept "application/json"
				# Privacy/opsec: the upstream (opendata.adsb.fi) sits behind
				# Cloudflare; strip its reporting/CF headers so nothing about the
				# upstream stack or a Cloudflare reporting endpoint reaches
				# visitors. The PREFIX match catches every Cf-* passthrough.
				header_down -Nel
				header_down -Report-To
				header_down -Reporting-Endpoints
				header_down -Reporting-To
				header_down -Cf-*
				header_down -Strict-Transport-Security
				header_down -Set-Cookie
				# Do not reveal upstream server details to the client
				header_down -Server
				header_down -Via
				header_down -X-Powered-By
			}
		}
	}
	# Anything else under /api/*: 405 when the lat/lon/dist shape matches
	# but the method is not GET/HEAD, 404 for every other path or method.
	# POST/PUT/DELETE and probing paths never reach adsb.fi. Caddy has no
	# 405 responder; respond with the status and set Allow on the 405s.
	@api_shape_any_method path_regexp ^/api/lat/-?[0-9]+(\.[0-9]+)?/lon/-?[0-9]+(\.[0-9]+)?/dist/[0-9]+/?$
	# A query on the otherwise-right shape must 404, not 405: 405 would
	# confirm to a prober that the shape exists (and its Allow header
	# leaks the method set). The bare-query matcher in @api_shaped already
	# excludes these from the proxy; this order makes the response
	# indistinguishable from an unknown path.
	@api_with_query {
		path_regexp ^/api/lat/-?[0-9]+(\.[0-9]+)?/lon/-?[0-9]+(\.[0-9]+)?/dist/[0-9]+/?$
		not query
	}
	handle /api/* {
		respond @api_with_query 404
		header @api_shape_any_method Allow "GET, HEAD"
		respond @api_shape_any_method 405
		respond 404
	}

	# Session 25c: privacy-first analytics (self-hosted GoatCounter, on the
	# VPS only, listening on 127.0.0.1). ONLY the count script and the count
	# endpoint are proxied from the main origin, so the page makes no
	# third-party request and the CSP stays 'self'. The dashboard is NOT
	# proxied: reach it via an SSH tunnel (docs/deploy.md 6b) or a separate
	# protected host decided by the maintainer.
	#
	# Privacy: this is the ONLY route that passes the visitor IP — over
	# localhost, to derive the country and the session key in GoatCounter's
	# memory (GoatCounter has no trusted-proxy setting; its mware.RealIP
	# trusts X-Forwarded-For/X-Real-Ip blindly, which is why the listener
	# must never be reachable except via this route). The ADS-B proxy above
	# still strips IP and headers; Caddy access logs stay off; GoatCounter
	# never logs the IP (its own /count request log is disabled and the
	# session-key debug log is never enabled: no -debug in production).
	#
	# The Host header selects the site (Site.ByHost; unknown hosts get a
	# 400), so it must be set to the vhost the site was created with.
	# reverse_proxy sets X-Forwarded-For with the client IP; inbound
	# client-supplied X-Forwarded-For values are ignored per Caddy's
	# trusted-proxies default (none trusted), so a visitor cannot spoof it.
	# Exactly /count (with any query string) and /count.js — nothing deeper
	# (the dashboard and everything else stay unreachable from this origin).
	# Rate limit (review finding): the count routes had none. The SPA
	# sends at most one /count per route change per visitor; 120/min per
	# /32,/64 key is ~4x the cadence of a visitor navigating non-stop and
	# comfortably absorbs multi-tab use, while capping a flood before it
	# can hammer GoatCounter (which has its own 4/s /count limit; ours
	# 429s first, at the edge).
	@goatcounter_count path /count
	handle @goatcounter_count {
		rate_limit {
			zone count_per_ip {
				key {http.request.remote.host/32,64}
				events 120
				window 1m
			}
		}
		reverse_proxy 127.0.0.1:8091 {
			header_up Host {host}
		}
	}
	handle /count.js {
		rate_limit {
			zone countjs_per_ip {
				key {http.request.remote.host/32,64}
				events 120
				window 1m
			}
		}
		reverse_proxy 127.0.0.1:8091 {
			header_up Host {host}
		}
	}

	# Self-hosted BRT-A basemap tiles (session: self-host PDOK tiles).
	# Served from /srv/vliegvuil/tiles (swapped atomically by
	# scripts/vps-tiles-update.js); long cache, no directory listing
	# (file_server never lists), 404 for missing tiles.
	# handle_path strips the /tiles/ prefix before file_server maps the
	# remaining path onto the root: /tiles/8/132/84.png -> /srv/vliegvuil/
	# tiles/8/132/84.png. A plain handle + root would resolve the FULL
	# request path under the root (/srv/vliegvuil/tiles/tiles/...) and 404.
	handle_path /tiles/* {
		# Cheap cached PNGs; a generous ceiling only (an abuser gains
		# nothing: they are served from disk). NOT under static_per_ip —
		# a legitimate panning visitor fires dozens of tile requests.
		rate_limit {
			zone tiles_per_ip {
				key {http.request.remote.host/32,64}
				events 600
				window 1m
			}
		}
		root * /srv/vliegvuil/tiles
		file_server
		header Cache-Control "public, max-age=604800"
	}
	# Map glyph ranges are static binary files. They must NOT fall back to
	# the SPA index.html (a 200 with HTML makes MapLibre's PBF parser fail);
	# a missing range has to be a real 404.
	handle /fonts/* {
		# Rate limit (review finding): static handles outside the SPA
		# catch-all had none. Files are cheap (from disk), so this is a
		# generous ceiling against a flood, keyed like static_per_ip.
		rate_limit {
			zone fonts_per_ip {
				key {http.request.remote.host/32,64}
				events 600
				window 1m
			}
		}
		file_server
	}
	# Hashed build output plus the unhashed MapLibre worker. Files only,
	# never the SPA fallback: a missing asset must be a real 404, not a
	# 200 with index.html. When the MapLibre worker was missing from the
	# build, the SPA fallback answered it with text/html and Firefox
	# rejected it ("disallowed MIME type"), which turned a packaging bug
	# into a MIME puzzle — a 404 here would have named the problem.
	# .mjs is served as text/javascript by Caddy's mime table (Go).
	handle /assets/* {
		# Rate limit (review finding): see /fonts above.
		rate_limit {
			zone assets_per_ip {
				key {http.request.remote.host/32,64}
				events 600
				window 1m
			}
		}
		file_server
	}
	# SPA routing: serve the file if it exists, otherwise index.html.
	# Must live inside a catch-all handle: a top-level try_files runs before
	# handle blocks and would rewrite /api/* to /index.html, bypassing the
	# proxy entirely.
	handle {
		# Per-IP rate limit for the SPA and its assets only. This zone is
		# scoped to the catch-all so it never counts /api (own 240/min
		# zone), /tiles, /fonts or /assets (own generous zones) requests —
		# otherwise tile traffic could starve the aircraft poll of its
		# budget (429s for /api).
		rate_limit {
			zone static_per_ip {
				key {http.request.remote.host/32,64}
				events 120
				window 1m
			}
		}
		# Session 25b: {path}/index.html serves the prerendered per-language
		# pages (/{lang}/, /{lang}/about/, /{lang}/attribution/); the final
		# /index.html is the SPA fallback for unknown deep links.
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

# www.vliegvuil.nl: redirect to the apex. The www CNAME in the DNS zone
# points at the apex, so Caddy obtains a certificate for www too and
# every request is moved to the canonical host in one hop.
www.vliegvuil.nl {
	redir https://vliegvuil.nl{uri} permanent
}
