# Pinned Caddy toolchain and module versions — the single source of truth
# for BOTH scripts/vps-caddy-update.sh (VPS build) and the validate-caddyfile
# job in .github/workflows/ci.yml. Bump these only in a PR where both
# consumers see the new pins at the same time (docs/deploy.md §9).
#
# Latest releases at pin time (consulted before writing):
#   caddy           https://github.com/caddyserver/caddy/releases/latest (v2.11.7)
#   xcaddy          https://github.com/caddyserver/xcaddy/tags (v0.4.7)
#   caddy-ratelimit https://github.com/mholt/caddy-ratelimit/tags (v0.1.0, only tag)
#   cache-handler   https://github.com/caddyserver/cache-handler/releases/latest (v0.17.0)
#   storages/otter  https://github.com/darkweak/storages/releases (v0.0.20)
CADDY_VERSION=v2.11.7
XCADDY_VERSION=v0.4.7
CADDY_RATELIMIT_VERSION=v0.1.0
CADDY_CACHE_HANDLER_VERSION=v0.17.0
CADDY_OTTER_VERSION=v0.0.20
