{
  "name": "@vliegvuil/data-build",
  "version": "0.1.0",
  "description": "VliegVuil data-build - Scripts producing snapshots and tiles",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsx src/build.ts",
    "build:dist": "tsc",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:sources": "tsx src/validate-sources.ts ../sources.json"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-unicorn": "^56.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MPL-2.0"
}
