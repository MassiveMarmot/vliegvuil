# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
coverage/
*.tsbuildinfo
.vite/
# Compiled output must never sit next to TypeScript sources (the fixtures
# shadowing bug: bundlers resolve .js before .ts, so a stale .js fixture
# silently wins over the edited .ts). Fixtures are committed as .ts only.
core/__tests__/fixtures/**/*.js
core/__tests__/fixtures/**/*.js.map
core/__tests__/fixtures/**/*.d.ts
core/__tests__/fixtures/**/*.d.ts.map

# Env and secrets (none should exist; see AGENTS.md)
.env
.env.*
!.env.example

# Data build: raw downloads and large outputs (rebuilt on the VPS)
data-build/cache/
data-build/tmp/
# Local rollback copies (session 22c: git history is the rollback in CI)
data-build/previous/
*.pmtiles
*.mbtiles

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
data-build/status/
