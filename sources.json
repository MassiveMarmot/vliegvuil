{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "VliegVuil data sources with metadata",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the source"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Source URL"
          },
          "license": {
            "type": "string",
            "description": "License identifier (SPDX)"
          },
          "licenseUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to license text"
          },
          "dataType": {
            "type": "string",
            "description": "Type of data provided"
          },
          "updateFrequency": {
            "type": "string",
            "description": "How often the data is updated"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date",
            "description": "Last update date"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes"
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "license",
          "dataType"
        ]
      }
    }
  },
  "required": [
    "sources"
  ],
  "sources": [
    {
      "id": "adsb-lol",
      "name": "adsb.lol",
      "url": "https://adsb.lol/",
      "license": "BSD-3-Clause (API code)",
      "licenseUrl": "https://github.com/adsblol/api/blob/main/LICENSE",
      "dataType": "Live ADS-B positions",
      "updateFrequency": "continuous (polled every 5s via proxy)",
      "lastUpdated": "2026-09-29",
      "notes": "API source is BSD-3-Clause (https://github.com/adsblol/api). Data comes from community feeders. TODO: note dynamic rate limits \u2014 future API key may require feeding adsb.lol (see README)."
    },
    {
      "id": "ourairports",
      "name": "OurAirports",
      "url": "https://ourairports.com/data/",
      "license": "Public Domain",
      "licenseUrl": "https://ourairports.com/data/",
      "dataType": "Airport database (airports.csv)",
      "updateFrequency": "nightly",
      "lastUpdated": "2026-09-29",
      "notes": "Verified 2026-09-29: 'All data is released to the Public Domain.' Download from https://raw.githubusercontent.com/davidmegginson/ourairports-data/main/airports.csv"
    },
    {
      "id": "tar1090-db",
      "name": "tar1090-db",
      "url": "https://github.com/wiedehopf/tar1090-db",
      "license": "ODC-By-1.0 (derived from Mictronics aircraft-database)",
      "licenseUrl": "https://github.com/Mictronics/aircraft-database/blob/main/LICENSE",
      "dataType": "Aircraft registration/type database (aircraft.csv.gz)",
      "updateFrequency": "monthly",
      "lastUpdated": "2026-09-29",
      "notes": "Download: https://github.com/wiedehopf/tar1090-db/raw/refs/heads/csv/aircraft.csv.gz \u2014 derived from Mictronics/aircraft-database, whose exports are made available under the Open Data Commons Attribution License (ODC-By-1.0)."
    },
    {
      "id": "pdok-brt",
      "name": "PDOK BRT Achtergrondkaart",
      "url": "https://www.pdok.nl/",
      "license": "CC-BY 4.0",
      "licenseUrl": "https://www.pdok.nl/open-data",
      "dataType": "Basemap tiles",
      "updateFrequency": "n/a",
      "lastUpdated": "2026-09-29",
      "notes": "Licence overview at https://www.pdok.nl/open-data. TODO: verify current PDOK tile URL"
    },
    {
      "id": "rivm-atlas-schiphol",
      "name": "RIVM / Atlas Leefomgeving \u2014 Schiphol noise contours",
      "url": "https://atlasleefomgeving.nl/",
      "license": "TODO: verify",
      "licenseUrl": "https://atlasleefomgeving.nl/",
      "dataType": "Schiphol Lden noise contours (48/56/70 dB)",
      "updateFrequency": "per study year",
      "lastUpdated": "2026-09-29",
      "notes": "TODO: verify exact dataset, year and licence on Atlas Leefomgeving before use"
    },
    {
      "id": "clo-nlr-regional",
      "name": "CLO/NLR \u2014 regional noise contours 2018 & 2024",
      "url": "https://www.clo.nl/",
      "license": "TODO: verify",
      "licenseUrl": "https://www.clo.nl/",
      "dataType": "Lden contours for Rotterdam, Eindhoven, Maastricht, Groningen Eelde",
      "updateFrequency": "2018 & 2024 studies",
      "lastUpdated": "2026-09-29",
      "notes": "TODO: verify dataset and licence. Eindhoven: civil Lden contours chosen (decision made); label 'civil traffic only' per spec \u00a710. Rotterdam/Groningen/Maastricht lack an airport decree \u2014 note in layer info text."
    }
  ]
}
