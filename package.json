{
  "name": "vliegvuil",
  "version": "0.1.0",
  "private": true,
  "description": "VliegVuil.nl - Visualisatie van vliegvervuiling in Nederland",
  "type": "module",
  "workspaces": [
    "core",
    "web",
    "data-build"
  ],
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @vliegvuil/core build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "preinstall": "npx only-allow pnpm",
    "validate:sources": "pnpm --filter @vliegvuil/data-build run validate:sources"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-unicorn": "^56.0.1",
    "only-allow": "^1.2.1",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.34.1",
  "license": "MPL-2.0"
}
